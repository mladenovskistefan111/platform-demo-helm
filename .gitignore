/frontend/charts/*.tgz
/payment-service/charts/*.tgz
/product-catalog-db/charts/*.tgz
/product-catalog-service/charts/*.tgz
/recommendation-service/charts/*.tgz
/shipping-service/charts/*.tgz
.DS_Store

# Never commit key material or environment files
*.key
*.pem
.env
.env.*
