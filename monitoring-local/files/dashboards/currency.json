{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "Currency Service — Metrics, Logs, Traces, Profiles (Node.js / OpenTelemetry + Pyroscope)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "RED Metrics (Rate / Errors / Duration)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "id": 50,
      "title": "Total Request Rate",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(rate(rpc_server_duration_seconds_count{job=\"currency-service\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 51,
      "title": "Error Rate",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "100 * sum(rate(rpc_server_duration_seconds_count{job=\"currency-service\", rpc_grpc_status_code!=\"0\"}[1m])) / sum(rate(rpc_server_duration_seconds_count{job=\"currency-service\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 52,
      "title": "p99 Latency (Convert)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(rpc_server_duration_seconds_bucket{job=\"currency-service\", rpc_method=\"Convert\"}[1m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 53,
      "title": "p99 Latency (GetSupportedCurrencies)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(rpc_server_duration_seconds_bucket{job=\"currency-service\", rpc_method=\"GetSupportedCurrencies\"}[1m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "id": 100,
      "title": "Method Breakdown — Convert / GetSupportedCurrencies",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "type": "stat",
      "id": 101,
      "title": "Convert — Total Calls",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(rpc_server_duration_seconds_count{job=\"currency-service\", rpc_method=\"Convert\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 102,
      "title": "Convert — Rate (req/s)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(rate(rpc_server_duration_seconds_count{job=\"currency-service\", rpc_method=\"Convert\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 103,
      "title": "GetSupportedCurrencies — Total Calls",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(rpc_server_duration_seconds_count{job=\"currency-service\", rpc_method=\"GetSupportedCurrencies\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 104,
      "title": "GetSupportedCurrencies — Rate (req/s)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(rate(rpc_server_duration_seconds_count{job=\"currency-service\", rpc_method=\"GetSupportedCurrencies\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 107,
      "title": "Request Rate by Method (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "sum(rate(rpc_server_duration_seconds_count{job=\"currency-service\"}[1m])) by (rpc_method)",
          "legendFormat": "{{rpc_method}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 108,
      "title": "Latency p50 / p95 / p99 (all methods)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(rpc_server_duration_seconds_bucket{job=\"currency-service\"}[1m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(rpc_server_duration_seconds_bucket{job=\"currency-service\"}[1m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(rpc_server_duration_seconds_bucket{job=\"currency-service\"}[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 109,
      "title": "Latency by Method (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rpc_server_duration_seconds_bucket{job=\"currency-service\", rpc_method=\"Convert\"}[1m])) by (le))",
          "legendFormat": "Convert",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(rpc_server_duration_seconds_bucket{job=\"currency-service\", rpc_method=\"GetSupportedCurrencies\"}[1m])) by (le))",
          "legendFormat": "GetSupportedCurrencies",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 110,
      "title": "gRPC Status Codes",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "stacking": { "mode": "normal" } },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "sum(rate(rpc_server_duration_seconds_count{job=\"currency-service\"}[1m])) by (rpc_grpc_status_code) > 0",
          "legendFormat": "code={{rpc_grpc_status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "id": 200,
      "title": "Node.js Runtime",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 201,
      "title": "Process Resident Memory",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "single" } },
      "targets": [
        {
          "expr": "nodejs_process_resident_memory_bytes{job=\"currency-service\"}",
          "legendFormat": "RSS",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 202,
      "title": "Heap Memory",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "nodejs_heap_size_used_bytes{job=\"currency-service\"}",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "expr": "nodejs_heap_size_total_bytes{job=\"currency-service\"}",
          "legendFormat": "total",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 203,
      "title": "Event Loop Lag",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "single" } },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_seconds{job=\"currency-service\"}",
          "legendFormat": "event loop lag",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 204,
      "title": "Active Handles & Requests",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "nodejs_active_handles_total{job=\"currency-service\"}",
          "legendFormat": "active handles",
          "refId": "A"
        },
        {
          "expr": "nodejs_active_requests_total{job=\"currency-service\"}",
          "legendFormat": "active requests",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 205,
      "title": "CPU Usage (cumulative seconds)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "nodejs_process_cpu_user_seconds{job=\"currency-service\"}",
          "legendFormat": "user",
          "refId": "A"
        },
        {
          "expr": "nodejs_process_cpu_system_seconds{job=\"currency-service\"}",
          "legendFormat": "system",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "id": 10,
      "title": "Logs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "collapsed": false
    },
    {
      "type": "logs",
      "id": 11,
      "title": "Live Logs — currency-service",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 42 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showTime": true,
        "showLabels": false,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "expr": "{service_name=\"currency-service\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Log Volume by Level",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 52 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 20, "stacking": { "mode": "normal" } },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "(?i)error|err" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byRegexp", "options": "(?i)warn" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (detected_level) (count_over_time({service_name=\"currency-service\"} | detected_level != \"\" [1m]))",
          "legendFormat": "{{detected_level}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "id": 20,
      "title": "Traces",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 58 },
      "collapsed": false
    },
    {
      "type": "table",
      "id": 21,
      "title": "Recent Traces — currency-service",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 59 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "query": "{resource.service.name = \"currency-service\"}",
          "queryType": "traceql",
          "limit": 20,
          "refId": "A",
          "tableType": "traces"
        }
      ]
    },
    {
      "type": "row",
      "id": 30,
      "title": "Profiles",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 69 },
      "collapsed": false
    },
    {
      "type": "flamegraph",
      "id": 31,
      "title": "CPU Flame Graph — currency-service",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 70 },
      "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
      "targets": [
        {
          "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
          "groupBy": [],
          "labelSelector": "{service_name=\"currency-service\"}",
          "profileTypeId": "wall:wall:nanoseconds:wall:nanoseconds",
          "queryType": "profile",
          "refId": "A"
        }
      ]
    },
    {
      "type": "flamegraph",
      "id": 32,
      "title": "Heap Allocation Flame Graph — currency-service",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 82 },
      "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
      "targets": [
        {
          "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
          "groupBy": [],
          "labelSelector": "{service_name=\"currency-service\"}",
          "profileTypeId": "memory:alloc_objects:count:space:bytes",
          "queryType": "profile",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["currency", "grpc", "nodejs", "observability"],
  "time": { "from": "now-30m", "to": "now" },
