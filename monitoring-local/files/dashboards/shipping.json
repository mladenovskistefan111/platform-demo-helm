{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "Shipping Service — Metrics, Logs, Traces, Profiles (holistic observability)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "RED Metrics (Rate / Errors / Duration)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "id": 50,
      "title": "Total Request Rate",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(rate(grpc_server_handled_total{job=\"shipping-service\", grpc_service=\"hipstershop.ShippingService\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 51,
      "title": "Error Rate",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "100 * sum(rate(grpc_server_handled_total{job=\"shipping-service\", grpc_service=\"hipstershop.ShippingService\", grpc_code!=\"OK\"}[1m])) / sum(rate(grpc_server_handled_total{job=\"shipping-service\", grpc_service=\"hipstershop.ShippingService\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 52,
      "title": "p99 Latency",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(grpc_server_handling_seconds_bucket{job=\"shipping-service\", grpc_service=\"hipstershop.ShippingService\"}[1m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 53,
      "title": "Active gRPC Streams",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(grpc_server_started_total{job=\"shipping-service\", grpc_service=\"hipstershop.ShippingService\"}) - sum(grpc_server_handled_total{job=\"shipping-service\", grpc_service=\"hipstershop.ShippingService\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Request Rate by Method (req/s)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "sum(rate(grpc_server_handled_total{job=\"shipping-service\", grpc_service=\"hipstershop.ShippingService\"}[1m])) by (grpc_method)",
          "legendFormat": "{{grpc_method}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Error Rate by Method (%)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "100 * sum(rate(grpc_server_handled_total{job=\"shipping-service\", grpc_service=\"hipstershop.ShippingService\", grpc_code!=\"OK\"}[1m])) by (grpc_method) / sum(rate(grpc_server_handled_total{job=\"shipping-service\", grpc_service=\"hipstershop.ShippingService\"}[1m])) by (grpc_method)",
          "legendFormat": "{{grpc_method}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Latency p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(grpc_server_handling_seconds_bucket{job=\"shipping-service\", grpc_service=\"hipstershop.ShippingService\"}[1m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(grpc_server_handling_seconds_bucket{job=\"shipping-service\", grpc_service=\"hipstershop.ShippingService\"}[1m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(grpc_server_handling_seconds_bucket{job=\"shipping-service\", grpc_service=\"hipstershop.ShippingService\"}[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Latency by Method (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(grpc_server_handling_seconds_bucket{job=\"shipping-service\", grpc_service=\"hipstershop.ShippingService\"}[1m])) by (le, grpc_method))",
          "legendFormat": "{{grpc_method}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "gRPC Status Codes",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "stacking": { "mode": "normal" } },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "sum(rate(grpc_server_handled_total{job=\"shipping-service\", grpc_service=\"hipstershop.ShippingService\"}[1m])) by (grpc_code) > 0",
          "legendFormat": "{{grpc_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "id": 7,
      "title": "Message Throughput",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Messages Received (msg/s)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "cps"
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(grpc_server_msg_received_total{job=\"shipping-service\", grpc_service=\"hipstershop.ShippingService\"}[1m])) by (grpc_method)",
          "legendFormat": "{{grpc_method}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Messages Sent (msg/s)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "cps"
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(grpc_server_msg_sent_total{job=\"shipping-service\", grpc_service=\"hipstershop.ShippingService\"}[1m])) by (grpc_method)",
          "legendFormat": "{{grpc_method}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "id": 60,
      "title": "Go Runtime",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 61,
      "title": "Goroutines",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "single" } },
      "targets": [
        {
          "expr": "go_goroutines{job=\"shipping-service\"}",
          "legendFormat": "goroutines",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 62,
      "title": "Memory Usage",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "go_memstats_alloc_bytes{job=\"shipping-service\"}",
          "legendFormat": "alloc (in use)",
          "refId": "A"
        },
        {
          "expr": "go_memstats_sys_bytes{job=\"shipping-service\"}",
          "legendFormat": "sys (total)",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 63,
      "title": "GC Pause Duration",
      "gridPos": { "h": 7, "w": 4, "x": 16, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "go_gc_duration_seconds{job=\"shipping-service\", quantile=\"0.5\"}",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "go_gc_duration_seconds{job=\"shipping-service\", quantile=\"0.75\"}",
          "legendFormat": "p75",
          "refId": "B"
        },
        {
          "expr": "go_gc_duration_seconds{job=\"shipping-service\", quantile=\"1\"}",
          "legendFormat": "max",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 64,
      "title": "GC Rate / Threads",
      "gridPos": { "h": 7, "w": 4, "x": 20, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(go_gc_duration_seconds_count{job=\"shipping-service\"}[1m])",
          "legendFormat": "GC runs/s",
          "refId": "A"
        },
        {
          "expr": "go_threads{job=\"shipping-service\"}",
          "legendFormat": "OS threads",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "id": 10,
      "title": "Logs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "collapsed": false
    },
    {
      "type": "logs",
      "id": 11,
      "title": "Live Logs — shipping-service",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 38 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showTime": true,
        "showLabels": false,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "expr": "{service_name=\"shipping-service\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Log Volume by Level",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 48 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 20, "stacking": { "mode": "normal" } },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "(?i)error|err" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byRegexp", "options": "(?i)warn" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (detected_level) (count_over_time({service_name=\"shipping-service\"} | detected_level != \"\" [1m]))",
          "legendFormat": "{{detected_level}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "id": 20,
      "title": "Traces",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 54 },
      "collapsed": false
    },
    {
      "type": "table",
      "id": 21,
      "title": "Recent Traces — shipping-service",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 55 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "query": "{resource.service.name = \"shipping-service\"}",
          "queryType": "traceql",
          "limit": 20,
          "refId": "A",
          "tableType": "traces"
        }
      ]
    },
    {
      "type": "row",
      "id": 30,
      "title": "Profiles",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 65 },
      "collapsed": false
    },
    {
      "type": "flamegraph",
      "id": 31,
      "title": "CPU Flame Graph — shipping-service",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 66 },
      "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
      "targets": [
        {
          "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
          "groupBy": [],
          "labelSelector": "{service_name=\"shipping-service\"}",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "queryType": "profile",
          "refId": "A"
        }
      ]
    },
    {
      "type": "flamegraph",
      "id": 32,
      "title": "Memory (alloc_objects) Flame Graph",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 78 },
      "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
      "targets": [
        {
          "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
          "groupBy": [],
          "labelSelector": "{service_name=\"shipping-service\"}",
          "profileTypeId": "memory:alloc_objects:count:space:bytes",
          "queryType": "profile",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["shipping", "grpc", "go", "observability"],
  "time": { "from": "now-30m", "to": "now" },
